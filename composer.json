{
  "name": "local/cgt",
  "type": "project",
  "description": "Laravel Inertia React starter scaffold.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "inertiajs/inertia-laravel": "^1.3"
  },
  "require-dev": {
    "laravel/pint": "^1.18"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
